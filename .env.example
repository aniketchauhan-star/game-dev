# NEXUS Play Studio — server environment.
# Copy to .env (git-ignored) and fill in what you need. Every value is optional:
# without a key the studio still imports and reviews decks, lets you author
# blueprints by hand, builds and exports games, and plays the bundled sample in
# demo mode. Only the server reads this file; nothing here reaches the browser.

# ── Claude ────────────────────────────────────────────────────────────────
# Your Anthropic API key (Claude Console). Read only by the API and worker processes.
ANTHROPIC_API_KEY=
# Model id. Verified against the Models API before any AI job runs.
# Leave empty to choose one in Settings from the models your key can use.
# Suggested: claude-opus-5-5
CLAUDE_MODEL=
# Server-side refusal fallback for models that support it: "default" or "off".
CLAUDE_REFUSAL_FALLBACK=default
# Per-request timeout in milliseconds (long outputs are streamed).
CLAUDE_TIMEOUT_MS=600000
# Bounded retries for rate limits and transient errors (max 5).
CLAUDE_MAX_RETRIES=2
# Extra attempts when a response fails schema validation (0–2).
CLAUDE_MAX_REPAIR_ATTEMPTS=1
# Optional: dated pricing for cost ESTIMATES (see config/pricing.example.json).
# Without it, usage is shown as token counts only — prices are never invented.
CLAUDE_PRICING_FILE=

# ── Figma (read-only design import) ───────────────────────────────────────
# A Figma personal access token with the file_content:read scope
# (current_user:read lets Settings show the account). Read only by the server;
# never sent to the browser, Claude, previews, logs or exports. Nothing is ever
# written back to Figma. Without it, upload exported PNG/JPEG/SVG/PDF screens.
# Hosted multi-user “Sign in with Figma” (OAuth) is not part of this build.
FIGMA_ACCESS_TOKEN=
# Seconds to wait automatically on a Figma rate limit (Retry-After) before
# stopping with a manual retry (max 120).
FIGMA_MAX_AUTO_WAIT_SECONDS=20
# Request timeout and largest image downloaded from Figma.
FIGMA_TIMEOUT_MS=30000
FIGMA_MAX_DOWNLOAD_MB=20
# Extra image hosts Figma may redirect renders to (comma-separated host names).
FIGMA_ASSET_HOSTS=

# ── Server ────────────────────────────────────────────────────────────────
# Loopback only. The studio has no login; do not expose it to a network.
HOST=127.0.0.1
PORT=5174
STUDIO_DEV_PORT=5173
# Where projects, uploads and the SQLite database live (git-ignored).
NEXUS_DATA_DIR=data

# ── Import limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=40
MAX_SLIDES=80
MAX_EXPANDED_MB=300
MAX_ZIP_ENTRIES=4000
MAX_XML_MB=8
MAX_IMAGE_MEGAPIXELS=50
MAX_ASSET_MB=25
MAX_PDF_PAGES=200

# ── Optional slide rendering (visual reference only) ─────────────────────
# "libreoffice" (auto-detects soffice), "docker", or "off".
RENDERER=libreoffice
# Full path to soffice if it is not on PATH, e.g.
# /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=
# Image with LibreOffice for RENDERER=docker (run with --network none).
RENDERER_DOCKER_IMAGE=
RENDER_TIMEOUT_MS=120000
